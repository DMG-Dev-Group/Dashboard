# Chave compartilhada exclusivamente entre a API do Dashboard e o serviço Kevin.
DASHBOARD_API_KEY=

# Origem permitida caso um cliente web autorizado precise chamar a API.
# Deixe em branco quando somente serviços servidor-a-servidor a utilizarem.
DASHBOARD_API_ALLOWED_ORIGIN=

# Use UMA das duas opções de credenciais do Firebase no ambiente de produção.
# Opção A: JSON completo da conta de serviço, serializado em uma única linha.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Opção B: campos individuais da conta de serviço.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Preserve as quebras como \n quando o provedor de ambiente exigir.
FIREBASE_PRIVATE_KEY=
